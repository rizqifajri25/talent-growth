PORT=4000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL / Supabase)
# DATABASE_URL: Runtime connection string used by Express & Prisma Client.
# - Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/talent_growth_dev?schema=public
# - Supabase (Transaction Pooler): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://user:password@localhost:5432/talent_growth_dev?schema=public

# DIRECT_URL: Direct database connection used by Prisma CLI for migrations.
# - Local PostgreSQL: same as DATABASE_URL (or direct connection)
# - Supabase (Direct / Session): postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://user:password@localhost:5432/talent_growth_dev?schema=public

# Authentication & JWT Configuration
# JWT_SECRET: Cryptographically secure secret key with at least 32 characters
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=talent-growth-api
JWT_AUDIENCE=talent-growth-web
JWT_ACCESS_TOKEN_TTL_SECONDS=900
